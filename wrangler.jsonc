{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traningslogg",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "traningslogg",
      "database_id": "02ff598c-d975-4db1-9f7e-d0514f92191c"
    }
  ],
  "observability": { "enabled": true },
  // Keep variables and secrets set in the Cloudflare dashboard (e.g. ANTHROPIC_API_KEY)
  // when GitHub pushes deploy a new version.
  "keep_vars": true,
  // Admin account created on first start if there are no users yet.
  // Only the PBKDF2 hash of the first password is stored here; change the password in the app.
  "vars": {
    "ADMIN_EMAIL": "hakan.andersson@gmail.com",
    "ADMIN_FIRST_NAME": "Håkan",
    "ADMIN_LAST_NAME": "Andersson",
    "ADMIN_PASSWORD_HASH": "pbkdf2$100000$Pb62qVj1qedQsC6sFgTIOQ==$JdsqPxAB87IOV6MJ3FZJK3kTVZLs3eas+E3R09v7y0I=",
    // AI help (optional). The API key is a secret: Cloudflare dashboard → Worker → Settings →
    // Variables and Secrets → ANTHROPIC_API_KEY. Caps are in kronor per calendar month.
    "AI_MODEL": "claude-haiku-5-5",
    "AI_PRICE_IN_USD": "0.10",
    "AI_PRICE_OUT_USD": "0.50",
    "USD_SEK": "11",
    "AI_USER_CAP_SEK": "20",
    "AI_TOTAL_CAP_SEK": "100"
  }
}
